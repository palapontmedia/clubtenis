# Copy this file to .env and fill in real values.
# Never commit .env with real secrets.

# PostgreSQL connection string (must support the btree_gist extension —
# any standard Postgres 13+ instance does, including Supabase/Neon/RDS).
DATABASE_URL="postgresql://postgres:password@localhost:5432/clubtenis?schema=public"

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Minutes a PENDING_PAYMENT reservation holds the court before it expires.
RESERVATION_HOLD_MINUTES="15"

# Optional: bearer token required to call /api/cron/expire-reservations.
# Leave unset in local development; set it in production and configure
# your scheduler to send `Authorization: Bearer <value>`.
CRON_SECRET=""
